# shellcheck source=/home/rick/bin/files/functionlib.bash
. ~/bin/files/functionlib.bash || {
	printf "\e[91mERROR:\e[0m Unable to source functionlib.bash\n"
	exit 1
}

help() {
	local -ri errcode="${1:-1}"
	local -r updated="23 Nov 2026"
	cat <<- _HELP_
	${orange}$script${normal} $version ($updated)
	Scans local network to see which addresses are active.

	${green}Usage:${normal} $script [-dhs]
	${orange}Available options:${normal}
	-d	Scan DHCP assigned addresses.
	-h	Show this help message and exit.
	-s	Scan static addresses.
	${orange}Note:${normal} Uses iputils-arping.
	_HELP_
	exit "$errcode"
}

check_dependencies() {
	local -r packages=( avahi-daemon avahi-utils libnss-mdns iputils-arping )
	check_packages "${packages[@]}"
	return 0
}

arping_check() {
	grep -E "0 response|0 packets received" < <(arping -c 1 "$ip_addr" ) >/dev/null 2>&1 && return 1 || return 0
}

scan_static_addresses() {
	local host_name ip_addr
	printf "\nScanning static IP addresses on the network...\n"
	printf "%s%sIP Address\tHostname%s\n" "$underline" "$green" "$normal"
	for ip_addr in $LOCALNET.{1..25}; do
		if arping_check "$ip_addr"; then
			host_name=$(awk '{print $NF}' < <(avahi-resolve -a "$ip_addr" 2>/dev/null) | sed 's/\.local$//')
			printf "%s\t" "$ip_addr"
			if [[ "$host_name" ]]; then
				printf "%s\n" "$host_name"
			else
				case $ip_addr in
					"$LOCALNET.1" ) printf "Gateway (TP Link AC1750)\n" ;;
					"$LOCALNET.2" ) printf "D-Link AP\n" ;;
					"$LOCALNET.3" ) printf "unassigned\n" ;;
					"$LOCALNET.4" ) printf "NASD97167 (QNAP NAS)\n" ;;
					"$LOCALNET.5" ) printf "unassigned\n" ;;
					"$LOCALNET.6" ) printf "Raspberry Pi 4\n" ;;
					"$LOCALNET.7" ) printf "unassigned\n" ;;
					"$LOCALNET.8" ) printf "unassigned\n" ;;
					"$LOCALNET.9" ) printf "unassigned\n" ;;
					"$LOCALNET.10" ) printf "hp-800g2-sff (Mint)\n" ;;
					"$LOCALNET.11" ) printf "hp-6005 (XFCE)\n" ;;
					"$LOCALNET.12" ) printf "e6500-deb (i3)\n" ;;
					"$LOCALNET.13" ) printf "probook-6570b (i3)\n" ;;
					"$LOCALNET.14" ) printf "hp-8300 (LMDE)\n" ;;
					"$LOCALNET.15" ) printf "dell-9020 (Mint)\n" ;;
					"$LOCALNET.16" ) printf "hp-8300-usdt (i3 Gitea Server)\n" ;;
					"$LOCALNET.17" ) printf "hp-800-g1-usdt (Mint)\n" ;;
					"$LOCALNET.18" ) printf "satellite-c875 (i3)\n" ;;
					"$LOCALNET.19" ) printf "hp-800-g1-dm (LMDE\n" ;;
					"$LOCALNET.20" ) printf "probook-6570 (Mint)\n" ;;
					"$LOCALNET.21" ) printf "hp-probook-6570 (Mint)\n" ;;
					"$LOCALNET.22" ) printf "hp-850-g3 (i3)\n" ;;
					"$LOCALNET.23" ) printf "hp-2560p (i3)\n" ;;
					"$LOCALNET.24" ) printf "e-475m (i3)\n" ;;
					"$LOCALNET.25" ) printf "unassigned\n" ;;
					* ) printf "\tUnknown host\n"
				esac
			fi
			(( count++ ))
		fi
	done
	return 0
}

scan_dhcp_addresses() {
	local host_name ip_addr
	printf "\nScanning DHCP addresses on the network...\n"
	printf "The scan may take several minutes to complete.\n"
	printf "%s%sIP Address\tHostname%s\n" "$underline" "$green" "$normal"
	for ip_addr in $LOCALNET.{100..254}; do
		if arping_check "$ip_addr"; then
			host_name=$(awk '{print $NF} ' < <(avahi-resolve -a "$ip_addr" 2>/dev/null) | sed 's/\.local$//')
			printf "%s\t" "$ip_addr"
			if [[ "$host_name" ]]; then
				printf "%s\n" "$host_name"
			else
				case $ip_addr in
					"$LOCALNET.153" ) printf "hp-850-g3 (i3)\n" ;;
					"$LOCALNET.193" ) printf "dell-9020 (Mint)\n" ;;
					"$LOCALNET.229" ) printf "EPSONF90159 (printer)\n" ;;
					"$LOCALNET.235" ) printf "X004000724XL (Roku)\n" ;;
					* ) printf "Unknown host\n"
				esac
			fi
			(( count++ ))
		fi
	done
	return 0
}

main() {
	local -r script="${0##*/}"
	local -r version="5.0.26327"
	local -i count=0
	local -i noOpt=1
	local -r optstr=":dhs"
	local opt OPTARG OPTIND
	SECONDS=0
	while getopts "$optstr" opt; do
		case "$opt" in
			d ) check_dependencies
				tput civis
				scan_dhcp_addresses
				tput cnorm ;;
			h ) help 0 ;;
			s ) check_dependencies
				tput civis
				scan_static_addresses
				tput cnorm ;;
			? ) printf "%s Invalid option -%s\n" "$RED_ERROR" "$OPTARG" >&2
				help "$E_INVALID_ARG"
		esac
		noOpt=0
	done
	if (( noOpt == 1 )); then
		printf "%s No argument passed\n" "$RED_ERROR" >&2
		help "$E_MISSING_ARG"
	fi
	shift "$(( OPTIND - 1 ))"
	printf "\n%d active addresses discovered in %s.\n" "$count" "$(format_time SECONDS)"
	over_line "$script $version"
	exit
}

main "$@"
