# shellcheck source=/home/rick/bin/files/functionlib.bash
. ~/bin/files/functionlib.bash || { printf "\e[91mERROR:\e[0m Unable to source functionlib.bash\n"; exit 1; }

help() {
	local -ri errcode="${3:-1}"
	local -r updated="24 Nov 2026"
	cat <<- _HELP_
	${orange}$script${normal} $version, updated: $updated
	Creates fortune cookie files for the fortune program.

	${green}Usage:${normal} $script <cookie-file>
	${orange}Available options:${normal}
	-h --help	Show this help message and exit
	_HELP_
	return "$errcode"
}

create_cookie_file() {
	# local -r cookiefile="$1"
	local -i code=0
	local -r fortunes_d=/usr/share/games/fortunes
	sudo_login 2
	printf "Creating %s.dat...\n" "$cookiefile"
	if strfile -c % "$cookiefile" "$cookiefile.dat" 2>/dev/null; then
		sudo cp -v "$cookiefile" "$cookiefile.dat" "$fortunes_d"/
		code="$?"
	else
		code="$?"
		printf "Fortune cookie operation failed.\n" >&2
	fi
	return "$code"
}

main() {
	local script="${0##*/}"
	local version="2.5.26328"
	local -i exit_code=0
	if [[ "$#" -eq 0  ]]; then
		printf "%s No argument passed." >&2 "$RED_ERROR"
		help "$E_MISSING_ARG"
	elif [[ "$1" = "-h" || "$1" = "--help" ]]; then
		help 0
	elif [[ ! -f "$1" ]]; then
		printf "%s %s not found.\n" "$RED_ERROR" "$cookiefile" >&2
		help "$E_FILENOTFOUND"
	else
		local -r cookiefile="$1"
		check_package fortune-mod
		create_cookie_file
	fi
	exit_code="$?"
	over_line "$script $version"
	exit "$exit_code"
}

main "$@"
