# shellcheck source=/home/rick/bin/files/functionlib.bash
source ~/bin/files/functionlib.bash || {
	printf "\e[91mERROR:\e[0m Unable to source functionlib.bash\n"
	exit 1
}

help() {
	local -ri errcode="${1:-1}"
	local -r updated="18 Nov 2026"
	cat <<- _HELP_
	${orange}$script${normal} $version, Updated: $updated
	Copies cronjob scripts to the appropriate directories.

	${green}Usage:${normal} $script [-abdfghmrstuv]
	${orange}Available options:${normal}
	-a    Copy all applicable scripts.
	-c    Copy cloned repo update script.
	-d    Copy defrag script.
	-f    Copy Finance backup scripts.
	-g    Copy Git repository backup scripts.
	-h    Show this help message and exit.
	-m    Copy Main PC backup scripts.
	-r    Copy Redshift notification script.
	-s    Copy script archive script.
	-t    Copy empty trash script.
	-u    Copy system update script.
	-y    Copy yt-dlp update script.
	NOTE: Multiple arguments may be passed to the script.
	_HELP_
	exit "$errcode"
}

is_older() {
	local -r cron_script="$1"
	local -r cron_path="$2"
	[[ "$cron_path/$cron_script" -ot "$cron_src/$cron_script" ]] && return "$TRUE" || return "$FALSE"
}

no_copy() {
	local -r message="$1"
	printf "%s not applicable to this system and not copied.\n" "$message"
	return 0
}

cp_clone_update() {
	case "$localip" in
		10|16|22 )
			no_copy "Cloned repository updates are" ;;
		* )
			is_older "clone-update.sh" "$user_cron_path" && cpv_base "$cron_src/clone-update.sh" "$user_cron_path"
	esac
	return 0
}

cp_git_bu() {
	case "$localip" in
		10|16 )
			is_older "git-dwm.sh" "$user_cron_path" && cpv_base "$cron_src/git-dwm.sh" "$user_cron_path"
			is_older "git-bu.sh" "$user_cron_path" && cpv_base "$cron_src/git-bu.sh" "$user_cron_path" ;;
		* )
			no_copy "Repository archives are"
	esac
	return 0
}

cp_main_bu() {
	local -r buScripts=(sync-nas.sh sync6005.sh journal-bu.sh passwdsync.sh repo-backup.sh)
	local buScript
	case "$localip" in
		10 )
			for buScript in "${buScripts[@]}"; do
				is_older "$buScript" "$user_cron_path" && cpv_base "$cron_src/$buScript" "$user_cron_path"
			done ;;
		* )
			no_copy "Main system sync scripts are"
	esac
	return 0
}

cp_finance_bu() {
	case "$localip" in
		10 )
			is_older "fin-bu.sh" "$user_cron_path" && cpv_base "$cron_src/fin-bu.sh" "$user_cron_path"
			is_older "hb-archive.sh" "$user_cron_path" && cpv_base "$cron_src/hb-archive.sh" "$user_cron_path" ;;
		* )
			no_copy "Finance archives are"
	esac
	return 0
}

cp_scriptarchive() {
	case "$localip" in
		17|21|22|24 )
			no_copy "scriptarchive.sh is" ;;
		* )
			is_older "scriptarchive.sh" "$user_cron_path" && cpv_base "$cron_src/scriptarchive.sh" "$user_cron_path"
	esac
	return 0
}

cp_empty_trash() {
	is_older "empty-trash.sh" "$user_cron_path" && cpv_base "$cron_src/empty-trash.sh" "$user_cron_path"
	return 0
}

cp_redshift_notify() {
	case "$localip" in
		10|11|14|15|17|19|20|21 )
			no_copy "redshift-notify.sh is" ;;
		* )
			is_older "redshift-notify.sh" "$user_cron_path" && cpv_base "$cron_src/redshift-notify.sh" "$user_cron_path"
	esac
	return 0
}

cp_zdefrag() {
	local -r anacron_path="/etc/cron.monthly/"
	case "$localip" in
		11|16 )
			[[ -d "$system_cron_path" ]] || { sudo_login 1; sudo mkdir -p "$system_cron_path"; }
			if is_older "z-defrag" "$system_cron_path"; then
				sudo_login 1
				cpvs_base "$cron_src/z-defrag" "$system_cron_path"
			fi ;;
		* )
			if is_older "z-defrag" "$anacron_path"; then
				sudo_login 1
				cpvs_base "$cron_src/z-defrag" "$anacron_path"
			fi ;;
	esac
	return 0
}

cp_zupdate() {
	local -r sed_file="update-cleanup.sed"
	local -r anacron_path="/etc/cron.weekly/"
	case "$localip" in
		11|16 )
			if is_older "z-update" "$system_cron_path"; then
				sudo_login 1
				cpvs_base "$cron_src/z-update" "$system_cron_path"
			fi ;;
		* )
			if is_older "z-update" "$anacron_path"; then
				sudo_login 1
				cpvs_base "$cron_src/z-update" "$anacron_path"
			fi
	esac
	if [[ "$sed_path/$sed_file" -ot "$sed_src/$sed_file" ]]; then
		sudo_login 1
		cpvs_base "$sed_src/$sed_file" "$sed_path"
	fi
	return 0
}

cp_zytdlpupdate() {
	local -r anacron_path="/etc/cron.daily/"
	case "$localip" in
		10|15|17 )
			if is_older "z-ytdlp-update" "$anacron_path"; then
				sudo_login 1
				cpvs_base "$cron_src/z-ytdlp-update" "$anacron_path"
			fi ;;
		* )
			no_copy "z-ytdlp-update is"
	esac
	return 0
}

main() {
	local -r script="${0##*/}"
	local -r version="12.0.26322"
	local -i exit_code=0
	localip="$(local_ip)"

	# Path variables
	script_dir=$(dirname "$(readlink -f "${0}")")
	local -r user_cron_path=~/.local/bin/
	local -r system_cron_path=/opt/bin/
	local -r sed_path=/usr/share/misc/
	local -r cron_src="$script_dir/cronjobs"
	local -r sed_src="$script_dir/files"

	# getopts variables
	local -i noOpt=1
	local -r optstr=":acdfghmrstuy"
	local opt OPTARG OPTIND
	[[ -d "$user_cron_path" ]] || mkdir -p "$user_cron_path"
	printf "Copying updated cron scripts...\n"
	while getopts "$optstr" opt; do
		case "$opt" in
			a ) cp_main_bu
				cp_finance_bu
				cp_git_bu
				cp_scriptarchive
				cp_empty_trash
				cp_clone_update
				cp_redshift_notify
				cp_zupdate
				cp_zdefrag
				cp_zytdlpupdate ;;
			c ) cp_clone_update ;;
			d ) cp_zdefrag ;;
			f ) cp_finance_bu ;;
			g ) cp_git_bu ;;
			h ) help 0 ;;
			m ) cp_main_bu ;;
			r ) cp_redshift_notify ;;
			s ) cp_scriptarchive ;;
			t ) cp_empty_trash ;;
			u ) cp_zupdate ;;
			y ) cp_zytdlpupdate ;;
			? ) printf "%s Invalid option -%s\n" "$RED_ERROR" "$OPTARG" >&2
				help "$E_INVALID_ARG"
		esac
		exit_code="$?"
		noOpt=0
	done
	if (( noOpt == 1 )); then
		printf "%s No argument passed.\n" "$RED_ERROR" >&2
		help "$E_MISSING_ARG"
	fi
	shift "$(( OPTIND - 1 ))"
	over_line "$script $version"
	exit "$exit_code"
}

main "$@"
