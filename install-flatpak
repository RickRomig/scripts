# shellcheck source=/home/rick/bin/functionlib.bash
source ~/bin/functionlib.bash || { printf "\e[91mERROR:\e[0m Unable to source functionlib.bash\n"; exit 1; }

install_flatpak() {
	printf "Installing Flatpak...\n"
	sudo_login 2
	sudo apt update -qq
	sudo apt install -y flatpak
	if ! installed flatpak; then
		printf "%s Flatpak installation failed.\n" "$RED_ERROR" >&2
		return "$E_INSTALLATION"
	fi
	printf "%s installed.\n" "$(flatpak --version)"
	return 0
}

install_flathub() {
	printf "Installing the Flathub repository ...\n"
	sudo flatpak remote-add --if-not-exists flathub https://flathub.org/repo/flathub.flatpakrepo
	printf "Flatbhub installed.\n"
	return 0
}

install_gnome_plugin() {
	# Install only if using Gnome Desktop Environment or Gnome Software Store is installed
	if installed flatpak && installed gnome-software; then
		exists gnome-software-plugin-flatpak || sudo apt-get install -y gnome-software-plugin-flatpak
		printf "Gnome software plugin installed.\n"
	fi
	return 0
}

main() {
	local -r script="${0##*/}"
	local -r version="2.0.26250"
	exit_code=0
	printf "Installs Flatpak and Flathub repository.\n"
	if installed flatpak; then
		printf "%s is already installed.\n" "$(flatpak --version)"
	else
		install_flatpak
		exit_code="$?"
	fi
	installed flatpak && install_flathub
	install_gnome_plugin
	over_line "$script $version"
	exit "$exit_code"
}

main "$@"
