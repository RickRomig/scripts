# shellcheck source=/home/rick/bin/files/functionlib.bash
. ~/bin/files/functionlib.bash || { printf "\e[91mERROR:\e[0m Unable to source functionlib.bash\n"; exit 1; }

help() {
	local -r updated="25 Nov 2026"
	cat <<- _HELP_
	${orange}$script${normal} $version, Updated $updated
	Mounts/Unmounts an SSHFS share.
	${green}Usage:${normal}
	Select the SSHFS share to mount from the menu.
	If the share is not already mounted, it will be mounted.
	If the share is currently mounted, you will be asked if you want to unmount the share.
	When unmounting the share, be sure you are not in the mount point.
	_HELP_
	exit 0
}

cd_fail() {
	printf "%s The cd shell builtin failed.\n" "$RED_ERROR" >&2
	printf "The SSHFS share has not been unmounted.\n" >&2
	return 0
}

fail_msg() {
	local -r mount_point="$HOME/mnt"
	printf "Make sure you are not in the mountpoint and run the following command:\n" >&2
	printf "\t%sfusermount -u %s/%s/%s\n" "$orange" "$mount_point" "$share_name" "$normal"  >&2
	return 0
}

mount_share() {
	ping -c3 "$LOCALNET.$share_ip" > /dev/null 2>&1 || die "$share_name at $LOCALNET.$octet is not online." "$E_NETWORK"
	[[ -d "$HOME/mnt/$share_name/" ]] || mkdir -p "$HOME/mnt/$share_name"
	printf "Mounting %s...\n" "$share_name"
	if [[ "$share_name" == "NASD97167" ]]; then
		sshfs -o follow_symlinks rick@"$LOCALNET.$share_ip:" "$HOME/mnt/$share_name/"
	else
		sshfs -o follow_symlinks rick@"$LOCALNET.$share_ip:$HOME" "$HOME/mnt/$share_name/"
	fi
	printf "Home directory at %s:\n" "$share_name"
	ls "$HOME/mnt/$share_name/"
	printf "%s at %s.%s has been mounted.\n" "$share_name" "$LOCALNET" "$share_ip"
	return 0
}

unmount_share() {
	if ! cd "$HOME"; then
		cd_fail
		fail_msg
		return "$E_DRIVE_ERROR"
	fi
	if fusermount -u "$HOME/mnt/$share_name/"; then
		printf "%s has been unmounted.\n" "$share_name"
		return 0
	fi
	printf "%s %s has not been unmounted." "$RED_ERROR" "$share_name" >&2
	fail_msg
	return "$E_DRIVE_ERROR"
}

mounted() {
	grep -q "$share_name" < <(mount) && return "$TRUE" || return "$FALSE"
}

handle_mount() {
	local -i code=0
	local -i ip
	ip=$(local_ip)
	if (( ip == share_ip )); then
		printf "%s Cannot mount/unmount local system.\n" "$RED_ERROR" >&2
		code="$E_DRIVE_ERROR"
	elif ! mounted "$share_name"; then
		mount_share "$share_ip" "$share_name"
		code="$?"
	elif default_yes "Unmount $share_name?"; then
		unmount_share "$share_name"
		code="$?"
	else
		printf "%s left mounted.\n" "$share_name"
		code="$?"
	fi
	return "$code"
}

select_share() {
	local -r share_list=(
		"4 NASD97167"
		"10 hp-800g2-sff"
		"11 hp-6005"
		"12 e6500-deb"
		"13 probook-6570b"
		"14 hp-8300"
		"15 dell-9020"
		"16 hp-8300-usdt"
		"17 hp-800-g1-usdt"
		"18 satellite-c875"
		"19 hp-800-g1-dm"
		"20 probook-6570"
		"21 hp-probook-6570"
		"22 hp-850-g3"
		"23 hp-2560p"
		"24 e-475m"
	)
	local -i share_ip index
	local _opt share_name
	COLUMNS="100"
	PS3="Select a share to mount. ("$(( 1 + ${#share_list[@]} ))" to quit.) "
	select _opt in "${share_list[@]}"; do
		if (( REPLY == 1 + ${#share_list[@]} )); then
			printf "Exiting. No share selected.\n"
			return 0
		elif (( REPLY > 0 && REPLY <= ${#share_list[@]} )); then
			index=$(( REPLY - 1 ))
			break
		else
			printf "Invalid option. Choose 1 - %d. %d to quit.\n" "${#share_list[@]}" "$(( 1 + ${#share_list[@]} ))"
		fi
	done
	share_ip=$(cut -d' ' -f1 <<< "${share_list[index]}")
	share_name=$(cut -d' ' -f2 <<< "${share_list[index]}")
	printf "Share IP = %d\n" "$share_ip"
	printf "Share name: %s\n" "$share_name"
	handle_mount
	return "$?"
}

main() {
	local -r script="${0##*/}"
	local -r version="6.3.26329"
	local -i exit_code=0
	local share_name share_ip
	[[ "$1" == '-h' || "$1" == --help ]] && help
	check_package sshfs
	printf "Mount or unmount an SSHFS share.\n"
	select_share
	exit_code="$?"
	over_line "$script $version"
	exit "$exit_code"
}

main "$@"
