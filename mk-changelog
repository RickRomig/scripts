# shellcheck source=/home/rick/bin/files/functionlib.bash
. ~/bin/files/functionlib.bash || {
	printf "\e[91mERROR:\e[0m Unable to source functionlib.bash\n"
	exit 1
}

create_changelog() {
	# local -r project="$1"
	local today script_dir
	today=$(date +"%d %B %Y")
	script_dir=$(dirname "$(readlink -f "${0}")")
	# script_dir=~/bin/
	printf "Creating changelog for %s...\n" "$project"
	sed -e '1d' \
		-e "s/<PROJECT>/$project/" \
		-e "s/<DATE>/$today/" "$script_dir/Templates/changelog.txt" > CHANGELOG.md
	edit_view_quit CHANGELOG.md
	return "$?"
}

main() {
	local -r script="${0##*/}"
	local -r version="3.0.26327"
	local -i exit_code=0
	local project="$1"
	[[ "$#" -eq 0 ]] && read -rp "Enter the project name: " project
	if [[ -f CHANGELOG.md ]]; then
		printf "%s CHANGELOG.md already exists.\n" "$RED_ERROR" >&2
		exit_code="$E_FILE_EXISTS"
	else
		create_changelog
		exit_code="$?"
	fi
	over_line "$script $version"
	exit "$exit_code"
}

main "$@"
