# shellcheck source=/home/rick/bin/functionlib.bash
source ~/bin/functionlib.bash || { printf "\e[91mERROR:\e[0m Unable to source functionlib.bash\n"; exit 1; }

help() {
	local -r script="$1"
	local -r version="$2"
	local -ri errcode="${1:-1}"
	local -r updated="02 Aug 2026"
	cat << _HELP_
${orange}$script${normal} $version, Upated: $updated
renames filenames containing spaces, replacing spaces with - or . or _

${green}Usage:${normal} $script [-dhpu]
${orange}Available options:${normal}
	-d	Replace spaces with dashes/hyphens
	-h	Show this help message and exit
	-p	Replace spaces with periods/dots
	-u	Replace spaces with underscores
_HELP_
  exit "$errcode"
}

replace_spaces() {
	local char="$1"
	if grep -q " " < <(find . -maxdepth 1 -type f); then
		case "$char" in
			"-" ) rename -v 's/ /-/g' ./* ;;
			"." ) rename -v 's/ /./g' ./* ;;
			"_" ) rename -v 's/ /_/g' ./* ;;
			* )	# Should never occur.
		esac
	else
		printf "No filenames containing spaces found in the current directory.\n"
		return 0
	fi
}

main() {
	local -r script="${0##*/}"
	local -r version="3.4.26214"
	local opt OPTARG OPTIND
	local -i noOpt=1
	local -r optstr=":dhpu"
	while getopts "$optstr" opt; do
		case "$opt" in
			d ) replace_spaces "-" ;;
			h ) help "$script" "$version" 0 ;;
			p ) replace_spaces "." ;;
			u ) replace_spaces "_" ;;
			? )
				printf "%s Invalid option -%s\n" "$RED_ERROR" "$OPTARG" >&2
				help "$script" "$version" "$E_INVALID_ARG"
		esac
		noOpt=0
	done
	[[ "$noOpt" = 1 ]] && { printf "%s No argument passed.\n" "$RED_ERROR" >&2; help "$script" "$version" "$E_MISSING_ARG"; }
	shift "$(( OPTIND - 1 ))"
	over_line "$script $version"
	exit
}

main "$@"
