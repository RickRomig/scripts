# shellcheck source=/home/rick/bin/files/functionlib.bash
source ~/bin/files/functionlib.bash || { printf "\e[91mERROR:\e[0m Unable to source functionlib.bash\n"; exit 1; }

readonly BU_DIR=~/.config/backup
readonly CFG_DIR=~/.config
declare -i BU_COUNT=0

# Backup algorhythms

home_bu(){
	local -r file="$1"
	if [[ -f "$HOME/$file" && -f "$BU_DIR/$file" ]]; then
		if [[ "$BU_DIR/$file" -ot "$HOME/$file" ]]; then
			awk -F"/" '{print "==> " $NF}' < <(cp -pv "$HOME/$file" "$BU_DIR/") | sed "s/'$//"
			(( BU_COUNT++ ))
		fi
	elif [[ -f "$HOME/$file" ]]; then
		awk -F"/" '{print "==> " $NF}' < <(cp -pv "$HOME/$file" "$BU_DIR/") | sed "s/'$//"
		(( BU_COUNT++ ))
	fi
	return 0
}

configs_bu() {
	local -r folder="$1"
	local -r file="$2"
	if [[ -f "$CFG_DIR/$folder/$file" && -f "$BU_DIR/$folder/$file" ]]; then
		if [[ "$BU_DIR/$folder/$file" -ot "$CFG_DIR/$folder/$file" ]]; then
			awk -F/ '{print "==> " $NF}' < <(cp -pv "$CFG_DIR/$folder/$file" "$BU_DIR/$folder/")  sed "s/'$//"
			(( BU_COUNT++ ))
		fi
	elif [[ -f "$CFG_DIR/$folder/$file" ]]; then
		[[ -d "$BU_DIR/$folder" ]] || mkdir -p "$BU_DIR/$folder"
		awk -F/ '{print "==> " $NF}' < <(cp -pv "$CFG_DIR/$folder/$file" "$BU_DIR/$folder/") | sed "s/'$//"
		(( BU_COUNT++ ))
	fi
	return 0
}

misc_bu() {
	local -r folder="$1"
	local -r file="$2"
	if [[ -f "$HOME/$folder/$file" && -f "$BU_DIR/$folder/$file" ]]; then
		if [[ "$BU_DIR/$folder/$file" -ot "$HOME/$folder/$file" ]]; then
			awk -F/ '{print "==> " $NF}' < <(cp -pv "$HOME/$folder/$file" "$BU_DIR/$folder/") | sed "s/'$//"
			(( BU_COUNT++ ))
		fi
	elif [[ -f "$HOME/$folder/$file" ]]; then
		[[ -d "$BU_DIR/$folder" ]] || mkdir -p "$BU_DIR/$folder"
		awk -F/ '{print "==> " $NF}' < <(cp -pv "$HOME/$folder/$file" "$BU_DIR/$folder/") | sed "s/'$//"
		(( BU_COUNT++ ))
	fi
	return 0
}

etc_bu() {
	local -r folder="$1"
	local -r file="$2"
	if [[ -f "$folder/$file" && -f "$BU_DIR/$file" ]]; then
		if [[ "$BU_DIR/$file" -ot "$folder/$file" ]]; then
			awk -F/ '{print "==> " $NF}' < <(cp -v "$folder/$file" "$BU_DIR/$file") | sed "s/'$//"
			(( BU_COUNT++ ))
		fi
	elif [[ -f "$folder/$file" ]]; then
		awk -F/ '{print "==> " $NF}' < <(cp -v "$folder/$file" "$BU_DIR/$file") | sed "s/'$//"
		(( BU_COUNT++ ))
	fi
	return 0
}

cinnamon_bu() {
	local -r cinn_backup="$1"
	if [[ -f "$CFG_DIR/$cinn_backup" && -f "$BU_DIR/$cinn_backup" ]]; then
		if [[ "$BU_DIR/$cinn_backup" -ot "$CFG_DIR/$cinn_backup" ]]; then
			awk -F"/" '{print "==> " $NF}' < <(cp -pv "$CFG_DIR/$cinn_backup" "$BU_DIR/") | sed "s/'$//"
			(( BU_COUNT++ ))
		fi
	elif [[ -f "$CFG_DIR/$cinn_backup" ]]; then
		awk -F"/" '{print "==> " $NF}' < <(cp -pv "$CFG_DIR/$cinn_backup" "$BU_DIR/") | sed "s/'$//"
		(( BU_COUNT++ ))
	elif is_cinnamon; then
		dconf dump /org/cinnamon/desktop/keybindings/ > "$HOME/.config/$cinn_backup"
		cp -pv "$CFG_DIR/$cinn_backup" "$BU_DIR/" | awk -F"/" '{print "==> " $NF}' | sed "s/'$S//"
		awk -F"/" '{print "==> " $NF}' < <(cp -pv "$CFG_DIR/$cinn_backup" "$BU_DIR/") | sed "s/'$//"
		(( BU_COUNT++ ))
	fi
	return 0
}

# Backup categories

bu_user_cfgs() {
	local -r lhost="${HOSTNAME:-$(hostname)}"
	[[ -f ~/$lhost.info ]] && home_bu "$lhost.info"
	[[ -f ~/.profile ]] && home_bu ".profile"
	[[ -f ~/.bashrc ]] && home_bu ".bashrc"
	[[ -f ~/.bash_aliases ]] && home_bu ".bash_aliases"
	[[ -f ~/.bash_profile ]] && home_bu ".bash_profile"
	[[ -f ~/.bash_logout  ]] && home_bu ".bash_logout"
	[[ -f ~/.inputrc ]] && home_bu ".inputrc"
	[[ -f ~/.face ]] && home_bu ".face"
	[[ -f ~/.xinitrc ]] && home_bu ".xinitrc"
	[[ -f ~/.imwheelrc ]] && home_bu ".imwheelrc"
	return 0
}

bu_i3_cfgs() {
	[[ -f "$CFG_DIR/i3/config" ]] && configs_bu "i3" "config"
	[[ -f "$CFG_DIR/i3/bar.conf" ]] && configs_bu "i3" "bar.conf"
	[[ -f "$CFG_DIR/i3/rules.conf" ]] && configs_bu "i3" "rules.conf"
	[[ -f "$CFG_DIR/i3/workspaces.conf" ]] && configs_bu "i3" "workspaces.conf"
	[[ -f "$CFG_DIR/i3/i3status.conf" ]] && configs_bu "i3" "i3status.conf"
	[[ -f "$CFG_DIR/dunst/dunstrc" ]] && configs_bu "dunst" "dunstrc"
	[[ -f "$CFG_DIR/polybar/i3bar.ini" ]] && configs_bu "polybar" "i3bar.ini"
	[[ -f "$CFG_DIR/polybar/config" ]] && configs_bu "polybar" "config"
	[[ -f "$CFG_DIR/polybar/config.ini" ]] && configs_bu "polybar" "config.ini"
	[[ -f "$CFG_DIR/rofi/config.rasi" ]] && configs_bu "rofi" "config.rasi"
	[[ -f "$CFG_DIR/rofi/arc_dark_colors.rasi" ]] && configs_bu "rofi" "arc_dark_colors.rasi"
	[[ -f "$CFG_DIR/rofi/arc_dark_transparent_colors.rasi" ]] && configs_bu "rofi" "arc_dark_transparent_colors.rasi"
	[[ -f "$CFG_DIR/rofi/keybinds.rasi" ]] && configs_bu "rofi" "keybinds.rasi"
	[[ -f "$CFG_DIR/rofi/power.rasi" ]] && configs_bu "rofi" "power.rasi"
	return 0
}

bu_editor_cfgs() {
	[[ -f ~/.nanorc ]] && home_bu ".nanorc"
	[[ -f "$CFG_DIR/nano/nanorc" ]] && configs_bu "nano" "nanorc"
	[[ -f "$CFG_DIR/micro/settings.json" ]] && configs_bu "micro" "settings.json"
	[[ -f "$CFG_DIR/VSCodium/User/settings.json" ]] && configs_bu "VSCodium/User" "settings.json"
	[[ -f "$CFG_DIR/geany/geany.conf" ]] && configs_bu "geany" "geany.conf"
	[[ -f "$CFG_DIR/fresh/config.json" ]] && configs_bu "fresh" "config.json"
	[[ -f "$CFG_DIR/fresh/tsconfig.json" ]] && configs_bu "fresh" "tsconfig.json"
	[[ -f "$CFG_DIR/marktext/preferences.json" ]] && configs_bu "marktext" "preferences.json"
	[[ -f ~/.bluefish/rcfile-2.0 ]] && misc_bu ".bluefish" "rcfile-2.0"
	return 0
}

bu_terminal_cfgs() {
	[[ -f "$CFG_DIR/kitty/kitty.conf" ]] && configs_bu "kitty" "kitty.conf"
	[[ -f "$CFG_DIR/terminator/config" ]] && configs_bu "terminator" "config"
	return 0
}

bu_keybindings() {
	local -r  cinn_backup="keybindings-backup.dconf"
	[[ -f "$CFG_DIR/$cinn_backup" ]] && cinnamon_bu "$cinn_backup"
	[[ -f "$CFG_DIR/i3/sxhkd/sxhkdrc" ]] && configs_bu "i3/sxhkd" "sxhkdrc"
	[[ -f "$CFG_DIR/i3/sxhkdrc" ]] && configs_bu "i3" "sxhkdrc"
	[[ -f "$CFG_DIR/i3/bindings.list" ]] && configs_bu "i3" "bindings.list"
	[[ -f "$CFG_DIR/i3/keybindings.conf" ]] && configs_bu "i3" "keybindings.conf"
	[[ -f "$CFG_DIR/micro/bindings.json" ]] && configs_bu "micro" "bindings.json"
	[[ -f "$CFG_DIR/geany/keybindings.conf" ]] && configs_bu "geany" "keybindings.conf"
	[[ -f "$CFG_DIR/kitty/keybindings.conf" ]] && configs_bu "kitty" "keybindings.conf"
	[[ -f "$CFG_DIR/kitty/bindings.list" ]] && configs_bu "kitty" "bindings.list"
	[[ -f ~/.xbindkeysrc ]] && home_bu ".xbindkeysrc"
	return 0
}

bu_conky_cfgs() {
	[[ -f ~/.conkyrc ]] && home_bu ".conkyrc"
	[[ -f "$CFG_DIR/conky/conky.conf" ]] && configs_bu "conky" "conky.conf"
	return 0
}

bu_misc_cfgs() {
	[[ -f "$CFG_DIR/bat/config" ]] && configs_bu "bat" "config"
	[[ -f "$CFG_DIR/neofetch/config.conf" ]] && configs_bu "neofetch" "config.conf"
	[[ -f "$CFG_DIR/fastfetch/config.jsonc" ]] && configs_bu "fastfetch" "config.jsonc"
	[[ -f "$CFG_DIR/clipit/clipitrc" ]] && configs_bu "clipit" "clipitrc"
	[[ -f "$CFG_DIR/keepassxc/keepassxc.ini" ]] && configs_bu "keepassxc" "keepassxc.ini"
	[[ -f ~/.gitconfig ]] && home_bu ".gitconfig"
	[[ -f "$CFG_DIR/git/config" ]] && configs_bu "git" "config"
	[[ -f ~/.git-credentials ]] && home_bu ".git-credentials"
	[[ -f "$CFG_DIR/git/credentials" ]] && configs_bu "git" "credentials"
	[[ -f "$CFG_DIR/glow/glow.yml" ]] && configs_bu "glow" "glow.yml"
	[[ -f "$CFG_DIR/picom/picom.conf" ]] && configs_bu "picom" "picom.conf"
	[[ -f "$CFG_DIR/picom.conf" ]] && misc_bu ".config" "picom.conf"
	[[ -f "$CFG_DIR/compton.conf" ]] && misc_bu ".config" "compton.conf"
	[[ -f "$CFG_DIR/redshift.conf" ]] && misc_bu ".config" "redshift.conf"
	[[ -f "$CFG_DIR/shellcheckrc" ]] && misc_bu ".config" "shellcheckrc"
	[[ -f "$CFG_DIR/zoom.conf" ]] && misc_bu ".config" "zoom.conf"
	[[ -f "$CFG_DIR/zoomuz.conf" ]] && misc_bu ".config" "zoomus.conf"
	[[ -f ~/.ssh/id_rsa ]] && misc_bu ".ssh" "id_rsa"
	[[ -f ~/.ssh/id_rsa.pub ]] && misc_bu ".ssh" "id_rsa.pub"
	[[ -f ~/.ssh/config ]] && misc_bu ".ssh" "config"
	[[ -f /etc/X11/xorg.conf.d/10-monitor.conf ]] && etc_bu "/etc/X11/xorg.conf.d" "10-monitor.conf"
	[[ -f /etc/X11/xorg.conf.d/10-force-vga1.conf ]] && etc_bu "/etc/X11/xorg.conf.d" "10-monitor.conf"
	return 0
}

completion_status() {
	if (( BU_COUNT < 1 )); then
		printf "Configuration files are up to date. No backup required.\n"
	elif (( BU_COUNT > 1 )); then
		printf "%d configuration files were backed up.\n" "$BU_COUNT"
	else
		printf "1 configuration file was backed up.\n"
	fi
	return 0
}

main() {
	local -r script="${0##*/}"
	local -r version="7.0.26300"
	[[ -d ~/.config/backup ]] || mkdir -p ~/.config/backup
	printf "Backing up configuration files...\n"
	bu_user_cfgs
	bu_i3_cfgs
	bu_editor_cfgs
	bu_terminal_cfgs
	bu_keybindings
	bu_conky_cfgs
	bu_misc_cfgs
	completion_status
	over_line "$script $version"
	exit
}

main "$@"
