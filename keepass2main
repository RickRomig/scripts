# shellcheck source=/home/rick/bin/files/functionlib.bash
. ~/bin/files/functionlib.bash || {
	printf "\e[91mERROR:\e[0m Unable to source functionlib.bash\n"
	exit 1
}

check_host() {
	local -r local_host="${HOSTNAME:-$(hostname)}"
	if [[ "$local_host" == "$main_host" ]]; then
		printf "%s cannot be run from %s\n" "$script" "$main_host" >&2
		return "$E_INVALID_HOST"
	fi
	return 0
}

copy_passwords() {
	local -ri main_ip=10
	local -r kdbx_d=~/Documents
	printf "Backing up passwords.kdbx on %s\n" "$main_host"
	ssh rick@"$LOCALNET.$main_ip" cp -pv "$kdbx_d"/Passwords.kdbx "$kdbx_d/Passwords.$(date '+%y%m%d').kdbx"
	printf "Copying updated KeepassXC databases to %s\n" "$main_host"
	scp -p "$kdbx_d"/Passwords*.kdbx "$kdbx_d"/Tina-passwords.kdbx  rick@"$LOCALNET.$main_ip":Documents/
	return "$?"
}

main() {
	local -r script="${0##*/}"
	local -r version="6.5.26327"
	local -r main_host="hp-800g2-sff"
	local -i exit_code=0
	check_host && copy_passwords
	exit_code="$?"
	over_line "$script $version" "-"
	exit "$exit_code"
}

main "$@"
