# shellcheck source=/home/rick/bin/files/functionlib.bash
. ~/bin/files/functionlib.bash || {
	printf "\e[91mERROR:\e[0m Unable to source functionlib.bash\n"
	exit 1
}

help() {
	local -ri errcode="${1:-1}"
	local -r updated="22 Nov 2026"
	cat <<- _HELP_
	${orange}$script${normal} $version ($updated)
	Installs, updates, or removes the Bat utililty.

	${green}Usage:${normal} $script [-hiru]
	${orange}Available options:${normal}
	-h	Show this help message and exit
	-i	Install Fastfetch
	-r	Remove Fastfetch
	-u	Update Fastfetch to the latest GitHub release
	_HELP_
	exit "$errcode"
}

ff_version() {
	fastfetch --version-raw
	return 0
}

newest_version() {
	local new_ver
	wget -qO "$TMP_FILE" "$gh_url"
	new_ver=$(awk -F'/' '/download/ && /amd64/ {print $6;exit}' "$TMP_FILE")
	echo "$new_ver"
	return 0
}

compare_versions() {
	local cur_ver
	local -i return_status=0
	cur_ver="$(ff_version)"
	printf "Comparing current and newest versions...\n"
	if [[ -z "$new_ver" ]]; then
		printf "%s No download available. Try again later.\n" "$RED_ERROR" >&2
		return_status="$E_DOWNLOAD"
	elif newer_version "$new_ver" "$cur_ver"; then
		printf "%sInstalled version of FastFetch is %s, updating to %s...%s\n" "$lightyellow" "$cur_ver" "$new_ver" "$normal"
		install_fastfetch "$new_ver" "$gh_url"
		return_status="$?"
	else
		printf "%sFastFetch %s is the current version. No update required.%s\n" "$lightyellow" "$cur_ver" "$normal"
	fi
	return "$return_status"
}

install_fastfetch(){
	local -r new_pkg="fastfetch-linux-amd64.deb"
	if [[ -z "$new_ver" ]]; then
		printf "%s No download available. Try again later." "$RED_ERROR" >&2
		return "$E_DOWNLOAD"
	fi
	sudo_login 2
	printf "Downloading FastFetch %s from the fastfetch-cli GitHub repository..." "$new_ver"
	dots "." &
	DOTS_PID="$!"
	wget -q -P "$TMP_DIR/" "$gh_url/download/$new_ver/$new_pkg"
	kill_dots
	printf "Installing FastFetch %s...\n" "$new_ver"
	sudo dpkg -i "$TMP_DIR/$new_pkg"; sudo apt-get install --fix-broken
	if [[ "$(ff_version)" != "$new_ver" ]]; then
		printf "%s Fastfetch installation failed.\n" "$RED_ERROR" >&2
		return "$E_INSTALLATION"
	fi
	printf "%sFastFetch %s installed.%s\n" "$lightyellow" "$(ff_version)" "$normal"
	return 0
}

remove_fastfetch() {
	sudo_login 2
	printf "Removing FastFetch %s ...\n" "$(ff_version)"
	sudo dpkg --purge fastfetch
	find ~/ -maxdepth 3 -type d -path "$HOME/Downloads" -prune -o -path "$HOME/gitea" -prune -o -type d -name fastfetch -exec rm -rf {} \;
	find /usr/share -type f,d -iname "fastfetch*" -exec sudo rm -rf {} \;
	printf "Fastfetch and its configuration files have been removed.\n"
}

fastfetch_config() {
	local -r conf_dir=~/.config/fastfetch
	local -r logo_dir=~/.local/share/fastfetch/logos
	local repository=~/Downloads/configs/fastfetch
	[[ -d ~/gitea/configs/fastfetch ]] && repository=~/gitea/configs/fastfetch
	if [[ ! -d "$repository" ]]; then
		printf "%s Cloned repository not found!\n" "$RED_WARNING" >&2
		return "$E_FILENOTFOUND"
	fi
	[[ -d "$conf_dir" ]] || mkdir -p "$conf_dir"
	[[ -d "$logo_dir" ]] || mkdir -p "$logo_dir"
	printf "Installing configuration and logo files...\n"
	if grep -q -E 'GM965|GL960' < <(lspci); then
		cpv_base "$repository"/config.jsonc.ascii "$conf_dir"/config.jsonc
		cpv_base "$repository"/logo.txt "$logo_dir/"
	else
		cpv_base "$repository"/config.jsonc "$conf_dir/"
		cpv_base "$repository"/logo.png "$logo_dir/"
	fi
	grep -qw gigi < <(lsb_release -cs) && sed -i '/type/s/kitty-direct/kitty/' "$conf_dir"/config.jsonc
	printf "Fastfetch configuration applied.\n"
	return 0
}

main() {
	local -r script="${0##*/}"
	local -r  version="4.15.26327"
	local -i exit_code=0
	local -r gh_url="https://github.com/fastfetch-cli/fastfetch/releases"
	local -i noOpt=1
	local -r optstr=":hiru"
	local opt OPTARG OPTIND new_ver
	while getopts "$optstr" opt; do
		case "$opt" in
			h ) help 0 ;;
			i ) if installed fastfetch; then
					printf "Fastfetch %s is already installed.\n" "$(ff_version)" >&2
				else
					check_package wget
					create_tmp "dirfile"
					new_ver="$(newest_version)"
					printf "%sInstalling Fastfetch version %s...%s\n" "$lightyellow" "$new_ver" "$normal"
					install_fastfetch && fastfetch_config
				fi ;;
			r ) if installed fastfetch; then
					remove_fastfetch
				else
					printf "Fastfetch is not installed.\n" >&2
				fi ;;
			u ) if installed fastfetch; then
					check_package wget
					create_tmp "dirfile"
					new_ver="$(newest_version )"
					compare_versions
				else
					printf "Fastfetch is not installed.\n" >&2
				fi ;;
			? ) printf "%s Invalid option -%s\n" "$RED_ERROR" "$OPTARG" >&2
				help "$E_INVALID_ARG"
		esac
		exit_code="$?"
		noOpt=0
	done
	if (( noOpt == 1 )); then
		printf "%s No argument passed\n" "$RED_ERROR" >&2
		help "$E_MISSING_ARG"
	fi
	shift "$(( OPTIND - 1 ))"
	over_line "$script $version"
	exit "$exit_code"
}

main "$@"
