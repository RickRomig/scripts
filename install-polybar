# shellcheck source=/home/rick/bin/functionlib.bash
source ~/bin/functionlib.bash || { printf "\e[91mERROR:\e[0m Unable to source functionlib.bash\n"; exit 1; }

copy_polybar_config() {
	local repository=~/Downloads/configs/polybar
	[[ -d ~/gitea/configs/polybar ]] && repository=~/gitea/configs/polybar
	if [[ ! -d "$repository" ]]; then
    printf "%s Repository not found!\n" "$RED_ERROR" >&2
    return "$E_FILENOTFOUND"
  fi
	local -r polybar_d=~/.config/polybar
	[[ -d "$polybar_d" ]] || mkdir -p "$polybar_d"
	printf "Copying the Polybar configuration files ...\n"
	[[ -f "$polybar_d/config.ini" ]] && cp "$polybar_d/config.ini" "$polybar_d/config.ini.bak"
	cp -av "$repository/polybar" "$polybar_d"
	[[ -x "$polybar_d/polybar-i3" ]] || chmod +x "$polybar_d/polybar-i3"
	configure_modules "$polybar_d"
	return 0
}

configure_modules() {
	local -r polybar_d="$1"
	local -r cfg_file="config.ini"
	local b_name e_name w_name
	# Get device names from the system.
	e_name=$(awk '/ethernet/ {print $1}' < <(/usr/bin/nmcli dev))
	w_name=$(awk '/wifi/ {print $1}' < <(/usr/bin/nmcli dev))
	b_name=$(find /sys/class/power_supply/ -name "BAT*"); b_name="${b_name##*/}"
	# Apply device names or exclude modules as required.
	if [[ "$w_name" ]]; then
		sed -i "s/wlan0/$w_name/" "$polybar_d/$cfg_file"
	else
		sed -i '/^modules-left/s/ wlan//' "$polybar_d/$cfg_file"
	fi
	if [[ "$e_name" ]]; then
		sed -i "s/eth0/$e_name/" "$polybar_d/$cfg_file"
	else
		sed -i '/^modules-left/s/ eth//' "$polybar_d/$cfg_file"
	fi
	if [[ "$b_name" ]]; then
		sed -i "s/BAT0/$b_name/" "$polybar_d/$cfg_file"
	else
		sed -i '/^modules-right/s/ battery//' "$polybar_d/$cfg_file"
	fi
	printf "polybar-i3 confgured.\n"
	return 0
}

install_polybar() {
	sudo_login 2
	sudo apt-get install -y polybar
	if ! installed polybar; then
		printf "%s Polybar installation failed\n" "$RED_ERROR" >&2
		return "$E_INSTALLATION"
	fi
	printf "Polybar installed.\n"
	copy_polybar_config
	return 0
}

main() {
  local script="${0##*/}"
  local version="2.11.26209"
  local -i exit_code=0
	printf "Installs Polybar on Debian with i3wm.\n"
	if installed polybar; then
		printf "Polybar is already installed.\n"
		default_no "Overwrite current polybar configuration?" && copy_polybar_config
	else
		install_polybar
	fi
	exit_code="$?"
	over_line "$script $version"
  exit "$exit_code"
}

main "$@"
