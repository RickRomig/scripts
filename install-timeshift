# shellcheck source=/home/rick/bin/functionlib.bash
source ~/bin/functionlib.bash || { printf "\e[91mERROR:\e[0m Unable to source functionlib.bash\n"; exit 1; }

get_snapshot_uuid() {
	local target_uuid
	# set UUID to /data partition if it exists
	target_uuid=$(awk '/data/ {print $(NF-3)}' < <(lsblk -f))
	# set UUID to home partition if no /data partition exists
	[[ "$target_uuid" ]] || target_uuid=$(awk '/home/ {print $(NF-3)}' < <(lsblk -f))
	# set UUID to root partition if no /home or /data partition exists
	[[ "$target_uuid" ]] || target_uuid=$(awk '/\/$/ {print $NF-3}' < <(lsblk -f))
	printf "%s" "$target_uuid"
	return 0
}

configure_timeshift() {
	local -r ts_dir="/etc/timeshift"
	if [[ -f "$ts_dir/timeshift.json" ]]; then
		printf "timeshift.json already exists.\n" >&2
		return "$E_FILE_EXISTS"
	fi
	local ts_uuid
	local -r repository=~/Downloads/configs/timeshift
	[[ -f ~/gitea/configs ]] && repository=~/gitea/configs/timeshift
	if [[ ! -d "$repository" ]]; then
		printf "%s Configs repository not found!\n" "$RED_ERROR" >&2
		return "$E_FILENOTFOUND"
	fi
	sudo_login 2
	printf "Configuring Timeshift...\n"
	ts_uuid=$(get_snapshot_uuid)
	awk -F"/" '{print "=> " $NF}' < <(sudo cp -v "$repository/timeshift.json" "ts_dir/") | sed "s/'//"
	sudo sed -i "/backup_device_uuid/ s/\"\",/\"$ts_uuid\",/" "$ts_dir/timeshift.json"
	return "$?"
}

install_timeshift() {
	if installed timeshift; then
		printf "%s is already installed.\n" "$(timeshift --version)" >&2
		return "$E_FILE_EXISTS"
	fi
	sudo_login 2
	printf "Installing Timeshift...\n"
	sudo apt-get install -y timeshift
	if ! installed timeshift; then
		printf "%s Timeshift installation failed." "$RED_ERROR" >&2
		return "$E_INSTALLATION"
	fi
	printf "Timeshift %s installed.\n" "$(timeshift --version)"
	return 0
}

check_args() {
	local -r ts_dir="/etc/timeshift"
	if [[ "$#" -eq 0 ]]; then
		printf "%s No argument passed.\n" "$RED_ERROR" >&2
		printf "Valid arguments are '--configure', '--install' or '--edit'\n" >&2
		return "$E_MISSING_ARG"
	fi
	case "$1" in
		--configure )
			installed timeshift && configure_timeshift ;;
		--install )
			install_timeshift && configure_timeshift ;;
		--edit )
			sudo_login 2
			sudo nano "$ts_dir/timeshift.json" ;;
		* )
			printf "%s Invalid argument.\n" "$RED_ERROR" >&2
			printf "Valid arguments are '--configure', '--install' or '--edit'\n" >&2
			return "$E_INVALID_ARG"
	esac
	return "$?"
}

main() {
	local -r script="${0##*/}"
	local -r version="4.0.26276"
	local -i exit_code=0
	check_args "$@"
	exit_code="$?"
	over_line "$script $version"
	exit "$exit_code"
}

main "$@"
