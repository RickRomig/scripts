	local log_file=~/.local/share/logs/repo-update.log
	if [[ -f "$log_file" ]]; then
		clear
		viewtext "$log_file"
		printf "\n"
	else
		printf "%sThe repository update log does not exist on %s.%s\n" "$orange" "$LHOST" "$normal"
		printf "The job is"
		[[ -x ~/.local/bin/repo-update.sh ]] && printf " scheduled but has not run.\n" || printf " not scheduled to run.\n"
	fi
	return 0
