	else
		printf "%sThe bash script archive log does not exist on %s.%s\n" "$orange" "$LHOST" "$normal"
		printf "The job is"
		[[ -x ~/.local/bin/scriptarchive.sh ]] && printf " scheduled but has not run.\n" || printf " not scheduled to run.\n"
	fi
	return 0
