# shellcheck source=/home/rick/bin/functionlib.bash
source ~/bin/functionlib.bash || { printf "\e[91mERROR:\e[0m Unable to source functionlib.bash\n"; exit 1; }

readonly LHOST="${HOSTNAME:-$(hostname)}"

show_header() {
	clear
	cat <<- _HEADER_
	${orange}I solemnly swear that I'm up to no good.${normal}
	Displays the contents of selected log files.
	Not all logs will be available on all systems.
_HEADER_
	printf "\n"
	return 0
}

sysinfo() {
	if [[ -f "$HOME/$LHOST.info" ]]; then
		clear
		printf "%s%s information:%s\n\n" "$lightgreen" "$LHOST" "$normal"
		viewtext "$HOME/$LHOST.info"
	else
		printf "%s%s.info not found on this system.%s\n" "$orange" "$LHOST" "$normal"
	fi
	return 0
}

update_log() {
	local -r log_file=/var/log/update.log
	if [[ -f "$log_file" ]]; then
		clear
		viewtext "$log_file"
	else
		printf "%sThe system update log does not exist on %s.%s\n" "$orange" "$LHOST" "$normal"
		printf "The job is"
		[[ -x /etc/cron.weekly/z-update || -x /opt/bin/z-update ]] && printf " scheduled but has not run.\n" || printf " not scheduled to run.\n"
	fi
	return 0
}

timeshift_snapshots() {
	if ! installed timeshift; then
		printf "\n%sTimeshift is not installed on %s.%s\n" "$orange" "$LHOST" "$normal"
		return "$E_NOT_DETECTED"
	fi
	if pgrep -x timeshift > /dev/null 2>&1; then
		printf "\n%sTimeshift is currently processing a snapshot.%s Try again later.\n" "$orange" "$normal"
		return 0
	fi
	sudo_login 0
	if [[ $(tail -n1 < <(sudo timeshift --list)) == "No snapshots found" ]]; then
		printf "\nNo Timeshift snapshots found.\n"
		return 0
	fi
	clear
	printf "%s%s - Timeshift Snapshots:%s\n" "$lightgreen" "$LHOST" "$normal"
	awk 'NR!=1 && NR!=3' 2>/dev/null <(sudo timeshift --list)
	return 0
}

defrag_log() {
	local -r log_file=/var/log/defrag.log
	if [[ -f "$log_file" ]]; then
		clear
		viewtext "$log_file"
	else
		printf "%sThe defragmentation report does not exist on %s.%s\n" "$orange" "$LHOST" "$normal"
		printf "The job is"
		[[ -x /etc/cron.monthly/z-defrag || -x /opt/bin/z-defrag ]] && printf " scheduled but has not run.\n" || printf " not scheduled to run.\n"
	fi
	return 0
}

ytdlpupdate_log() {
	local -r log_file=/var/log/ytdlpup.log
	local -i entries
	if [[ -f "$log_file" ]]; then
		clear
		printf "%s%s - yt-dlp Update Log:%s\n" "$lightgreen" "$LHOST" "$normal"
		column -t -s "|" -N DATE,TIME,VERSION "$log_file"
		print_line "-" "29"
		entries=$(wc -l < "$log_file")
		(( entries > 1 )) && printf "%s entries\n" "$entries" || printf "%s entry\n" "$entries"
	else
		printf "%sThe yt-dlp update log does not exist on %s.%s\n" "$orange" "$LHOST" "$normal"
		printf "The job is"
		[[ -x /etc/cron.daily/z-ytdlp-update ]] && printf " scheduled but has not run.\n" || printf " not scheduled to run.\n"
	fi
	return 0
}

