# shellcheck source=/home/rick/bin/files/functionlib.bash
source ~/bin/files/functionlib.bash || { printf "\e[91mERROR:\e[0m Unable to source functionlib.bash\n"; exit 1; }

help() {
	local -r script="$1"
	local -r version="$2"
	local -ri errcode="${3:-1}"
	local -r updated="20 Oct 2026"
	cat <<- _HELP_
	${orange}$script${normal} $version (updated $updated)
	Displays a text file using either cat or less depending the number of lines in
	the file and the number of rows in the current terminal window. Less is used when
	the number of lines is greater than the 87% of the rows, otherwise cat is used.

	${green}Usage:${normal} $script [-h] [filename [-n|n]]
	${orange}Available options:${normal}
	  -h	Show this help message and exit.
	  -n	Display line numbers (follows filename and is case-insensitive).
	_HELP_
	exit "$errcode"
}

check_file() {
	local -r filename="$1"
	if [[ -z "$filename" ]]; then
		printf "%s No argument passed.\n" "$RED_ERROR" >&2
		help "$script" "$version" "$E_MISSING_ARG"
	elif [[ ! -f "$filename" ]]; then
		printf "%s %s not found.\n" "$RED_ERROR" "$filename" >&2
		return "$E_FILENOTFOUND"
	elif [[ ! -s "$filename" ]]; then
		printf "%s %s is an empty file.\n" "$RED_ERROR" "$filename" >&2
		return "$E_UNSUPPORTED"
	elif grep -qEi "text|json" < <(file -bL "$filename"); then
		return 0
	else
		printf "%s %s is not a valid text file.\n" "$RED_ERROR" "$filename" >&2
		return "$E_UNSUPPORTED"
	fi
}

set_flag() {
	local option="$1"
	local -i flag=1
	[[ "${option:0:1}" != "-" ]] && option="${option:0:1}"	# take 1st character of string
	[[ "${option:0:1}" == "-" ]] && option="${option:0:2}"	# take 1st two characters if 1st is '-'
	[[ "$option" == "-n" || "$option" == "n" ]] && flag=0 || flag=1
	printf "%s" "$flag"
	return 0
}

over_max() {
	local -r textfile="$1"
	local -i catmax filelines
	catmax=$(( $(tput lines)*87/100 ))
	filelines=$(wc -l < "$textfile")
	(( filelines > catmax )) && return "$TRUE" || return "$FALSE"
}

view_file() {
	local -r textfile="$1"
	local -ri flag="$2"
	if over_max "$textfile"; then
		case "$flag" in
			0 )
				less -N "$textfile" ;;
			* )
				less "$textfile"
		esac
		head -n5 "$textfile"
	else
		case "$flag" in
			0 )
				cat -n "$textfile" ;;
			* )
				cat "$textfile"
		esac
	fi
	printf "%sFile: %s%s\n" "$reverse" "$textfile" "$normal"
	return 0
}

main() {
	local -r script="${0##*/}"
	local -r version="8.5.26298"
	local -i exit_code=0
	local -i n_flag=1
	[[ $1 == "-h" ]] && help "$script" "$version" 0
	local -r filename="$1"
	local -l n_option="${2:-z}"	# make argument lowercase
	n_flag=$(set_flag "$n_option")
	check_file "$filename" && view_file "$filename" "$n_flag"
	exit_code="$?"
	over_line "$script $version"
	exit "$exit_code"
}

main "$@"
