## Source function library ##
# shellcheck source=/home/rick/bin/functionlib.bash
source functionlib.bash || { printf "\e[91mERROR:\e[0m Unable to source functionlib.bash\n"; exit 1; }

# shellcheck disable=SC2317
# Don't warn about unreachable commands in this function
# ShellCheck may incorrectly believe that code is unreachable if it's invoked by variable name or in a trap.
cleanup() {
  [[ -d "$TMP_DIR" ]] && rm -rf "$TMP_DIR"
}

install_NerdFonts() {
  local -r font_dir="$1"
  local -i return_code=0
  local -r font_repo="https://github.com/ryanoasis/nerd-fonts/releases/download/v3.4.0"
  local font fonts
  fonts=( "FiraCode" "Go-Mono" "Hack" "Inconsolata" "Iosevka" "JetBrainsMono" "Mononoki" "RobotoMono" "SourceCodePro" )
  for font in "${fonts[@]}"; do
    printf "\e[03mInstalling %s ...\e[0m\n" "$font"
    wget -q -P "$TMP_DIR" "$font_repo/$font.tar.xz"
    mkdir -p "$font_dir/$font/"
    tar xvf "$TMP_DIR/$font.tar.xz" -C "$font_dir/$font/"
    return_code="$?"
    (( return_code > 0 )) && break
  done
  if (( return_code > 0 )); then
    printf "%s NerdFonts installation failed.\n" "$RED_ERROR" >&2
  else
    printf "Nerd fonts installed.\n"
  fi
  return "$return_code"
}

install_SymbolNerdFonts() {
  local -r font_dir="$1"
  local repository=~/Downloads/configs
  [[ -d ~/gitea/configs ]] && repository=~/gitea/configs
  if [[ ! -d "$repository" ]]; then
    printf "%s Repository directory not found!\n" "$RED_ERROR" >&2
    printf "Symbols Nerd Fonts not installed.\n" >&2
    return "$E_FILENOTFOUND"
  fi
  cp -v "$repository"/local/nerdfonts/*.ttf "$font_dir/"
  printf "Symbols Nerd Fonts installed.\n"
  return 0
}

NerdFont_inatall() {
  local -r font_dir=~/.local/share/fonts
  [[ -d "$font_dir" ]] || mkdir -p "$font_dir"
  TMP_DIR=$(mktemp -d) || die "Failed to create temporary directory." "$E_TEMP_DIR"
  trap cleanup EXIT
  install_NerdFonts "$font_dir" && install_SymbolNerdFonts "$font_dir"
  return "$?"
}

main() {
  local -r script="${0##*/}"
  local -r version="2.0.26207"
  local -i exit_code=0
  check_packages wget
  NerdFont_inatall
  exit_code="$?"
  fc-cache
  over_line "$script $version"
  exit "$exit_code"
}

main "$@"
