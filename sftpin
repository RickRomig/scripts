# shellcheck source=/home/rick/bin/files/functionlib.bash
. ~/bin/files/functionlib.bash || { printf "\e[91mERROR:\e[0m Unable to source functionlib.bash\n"; exit 1; }

help() {
	local -ri errcode="${1:-1}"
	local -r updated="27 Nov 2026"
	cat <<- _HELP_
	${orange}$script${normal} $version ($updated)
	Log in to a remote server using Secure File Transfer Protocol (SFTP).

	${green}Usage:${normal} $script [last_octet] [-h | --help]
	${orange}Example:${normal} $script 15
	Argument is the last octet of the remote server's IP address (1-255).
	Assumes a /24 network.
	_HELP_
	exit "$errcode"
}

sftp_in() {
	if valid_ip "$hostip"; then
		/usr/bin/sftp "$LOCALNET.$hostip"
	else
		help "$?"
	fi
	return "$?"
}

main() {
	local -r script="${0##*/}"
	local -r version="2.10.26331"
	local -i hostip="$1"
	(( $# == 0 )) && read -rp "Enter last octet of remote server's IP address: " hostip
	[[ "$1" == "-h" || "$1" == "--help" ]] && help "$script" "$version" 0
	sftp_in
	over_line "$script $version"
	exit
}

main "$@"
