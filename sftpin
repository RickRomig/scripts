# shellcheck source=/home/rick/bin/functionlib.bash
source ~/bin/functionlib.bash || { printf "\e[91mERROR:\e[0m Unable to source functionlib.bash\n"; exit 1; }

help() {
  local -r script="$1"
  local -r version="$2"
  local -ri errcode="${3:-1}"
  local -r updated="03 Aug 2026"
  cat << _HELP_
${orange}$script${normal} $version ($updated)
Log in to a remote server using Secure File Transfer Protocol (SFTP).

${green}Usage:${normal} $script [last_octet] [-h | --help]
${orange}Example:${normal} $script 15
Argument is the last octet of the remote server's IP address.
Assumes a /24 network.
_HELP_
  exit "$errcode"
}

sftp_in() {
  local -r hostip="$1"
  if valid_ip "$hostip"; then
    /usr/bin/sftp "$LOCALNET.$hostip"
  else
    help "$script" "$version" "$?"
  fi
  return 0
}

main() {
  local -r script="${0##*/}"
  local -r version="2.8.26215"
  [[ "$1" == "-h" || "$1" == "--help" ]] && help "$script" "$version" 0
  local hostip="$1"
  [[ "$hostip" ]] || read -rp "Enter last octet of remote server's IP address: " hostip
  sftp_in "$hostip"
  over_line "$script $version"
  exit
}

main "$@"
