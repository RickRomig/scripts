## Source function library ##
# shellcheck source=/home/rick/bin/functionlib.bash
source ~/bin/functionlib.bash || { printf "\e[91mERROR:\e[0m Unable to source functionlib.bash\n"; exit 1; }

help() {
  local -r script="$1"
  local -r version="$2"
	local -ri errcode="${3:-1}"
	local updated=" 26 Jul 2026"
  cat << _HELP_
${orange}$script${normal} $version ($updated)
Installs/Removes Geany text editor and themes

${green}Usage:${normal} $script [-h] [-v[cirt]]
${orange}Available options:${normal}
  -c  Apply Geany configuration.
  -h  Show this help message and exit.
  -i  Install the Geany editor.
  -r  Remove the Geany editor.
  -t  Install Geany themes.
  -v  Enable verbose mode. If used, must precede other flags.
NOTE: for a full installation with cofniguation and themes, enter '$script =ict'
_HELP_
  exit "$errcode"
}

geany_version() {
  awk '/^ii/ {print $3}' < <(dpkg -l geany)
  return 0
}

geany_config() {
  local -r geany_cfg_d=~/.config/geany
  local repository=~/Downloads/configs/geany
  [[ -d ~/gitea/configs/geany ]] && repository=~/gitea/configs/geany
  if [[ ! -d "$repository" ]]; then
    printf "%s Configs repository not found!\n" "$RED_ERROR" >&2
    return "$E_FILENOTFOUND"
  fi
  [[ -d "$geany_cfg_d" ]] || mkdir -p "$geany_cfg_d"
  show_message "Applying configuration files."
  cp -av "$repository"/. "$geany_cfg_d"
  printf "Geany configuration files applied.\n"
  return 0
}

clone_themes() {
  local -r themes_url="https://github.com/geany/geany-themes.git"
  local -r colorschemes_dir=~/.config/geany/colorschemes
  local -r cloned_dir=~/Downloads/geany-themes
  [[ -d "$colorschemes_dir" ]] || mkdir -p "$colorschemes_dir"
  show_message "Cloning Geany themes..."
  git clone "$themes_url" "$cloned_dir"
  show_message "Copying Geany colorschemes..."
  awk -F"/" '{print "=> " $NF}' < <(cp -av "$cloned_dir"/colorschemes/. "$colorschemes_dir/") | sed "s/'//"
  printf "Geany themes installed.\n"
  return 0
}

install_geany() {
  sudo_login 2
  show_message "Installing Geany from repositories..."
  sudo apt-get install -y geany
  if ! installed geany; then
    printf "%s Geany installation failed.\n" "$RED_ERROR" >&2
    return "$E_INSTALLATION"
  fi
  printf "Geany %s installed.\n" "$(geany_version)"
  return 0
}

remove_geany() {
  sudo_login 2
  show_message "Removing Geany $(geany_version)..."
  sudo apt-get purge -y geany
  show_message "Removing Geany configuration files ..."
  find ~/.config -type d -name geany -exec rm -rf {} \;
  sudo find /usr/share -type f,d -name "geany*" -exec sudo rm -rf {} \;
  printf "Geany and configuration files removed.\n"
  return 0
}

show_message() {
	local -r message="$1"
	[[ "$VERBOSE" == "$TRUE" ]] && echo "$message"
  return 0
}

main() {
  VERBOSE="$FALSE"
  local -r script="${0##*/}"
  local -r version="3.4.26145"
  local -i exit_code=0
  local opt OPTARG OPTIND
  local -i noOpt=1
  local -r optstr=":chirtv"
  check_package git
  while getopts "$optstr" opt; do
    case "$opt" in
      c )
        if installed geany; then
          geany_config
        else
          printf "Geany is not installed.\n"
        fi
       ;;
      h )
        help "$script" "$version" 0
        ;;
      i )
        if installed geany; then
          printf "Geany %s is already installed.\n" "$(geany_version)"
        else
          install_geany
        fi
        ;;
      r )
        if installed geany; then
          remove_geany
        else
          printf "Geany is not installed.\n"
        fi
        ;;
      t )
        if installed geany; then
          clone_themes
        else
          printf "Geany is not installed.\n"
        fi
        ;;
      v )
        VERBOSE="$TRUE"
			  show_message "Verbose mode enabled."
        ;;
      ? )
        printf "%s Invalid option -%s\n" "$RED_ERROR" "$OPTARG" >&2
        help "$script" "$version" "$E_INVALID_ARG"
    esac
    exit_code="$?"
    noOpt=0
  done
  [[ "$noOpt" = 1 ]] && { printf "%s No argument passed.\n" "$RED_ERROR" >&2; help "$script" "$version" "$E_MISSING_ARG"; }
  shift "$(( OPTIND - 1 ))"
  over_line "$script $version"
  exit "$exit_code"
}

main "$@"
