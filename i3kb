# shellcheck source=/home/rick/bin/files/functionlib.bash
source ~/bin/files/functionlib.bash || { printf "\e[91mERROR:\e[0m Unable to source functionlib.bash\n"; exit 1; }

copy_bindings() {
	local -r i3_dir="$1"
	local -r bindings="$2"
	local repository
	repository=$(assign_cfg_repo)
	printf "Copying i3 keyboard bindings...\n"
	awk -F/ '{print "==> "$NF}' < <(cp -v "$repository/$bindings" "$i3_dir/$bindings") | sed "s/'$//"
	return 0
}

show_bindings() {
	local -r i3_dir=~/.config/i3
	local -r i3_bindings=keybindings.conf
	[[ -f "$i3_dir/$bindings" ]] || copy_bindings "$i3_dir" "$bindings"
	printf "i3wm keybindings:\n"
	column -t -s "|" -N Binding,Action,Binding,Action "$i3_dir/$bindings"
	return 0
}

main() {
	local -r script="${0##*/}"
	local -r version="1.13.26301"
	local -i exit_code=0
	if [[ "$DESKTOP_SESSION" == "i3" ]]; then
		clearscreen
		check_package git
		show_bindings "$i3_dir" "$i3_bindings"
	else
		printf "i3wm is not the current desktop session.\n"
		exit_code="$E_UNSUPPORTED"
	fi
	over_line "$script $version"
	exit "$exit_code"
}

main "$@"
