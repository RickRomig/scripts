# shellcheck source=/home/rick/bin/files/functionlib.bash
source ~/bin/files/functionlib.bash || {
	printf "\e[91mERROR:\e[0m Unable to source functionlib.bash\n"
	exit 1
}

copy_bindings() {
	local repository
	repository=$(assign_cfg_repo)
	printf "Copying i3 keyboard bindings...\n"
	cpv_base "$repository/i3/$bindings" "$i3_dir/$bindings"
	return 0
}

show_bindings() {
	local -r i3_dir=~/.config/i3
	local -r bindings=keybindings.conf
	[[ -f "$i3_dir/$bindings" ]] || copy_bindings
	printf "%s%si3wm keybindings:%s\n" "$bold" "$green" "$normal"
	column -t -s "|" -N Binding,Action,Binding,Action "$i3_dir/$bindings"
	return 0
}

main() {
	local -r script="${0##*/}"
	local -r version="2.0.26322"
	local -i exit_code=0
	if pgrep -f i3 &>/dev/null; then
		clearscreen
		check_package git
		show_bindings
	else
		printf "i3wm is not the current desktop session.\n" >&2
		exit_code="$E_UNSUPPORTED"
	fi
	over_line "$script $version"
	exit "$exit_code"
}

main "$@"
