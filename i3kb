# shellcheck source=/home/rick/bin/functionlib.bash
source ~/bin/functionlib.bash || { printf "\e[91mERROR:\e[0m Unable to source functionlib.bash\n"; exit 1; }

copy_bindings() {
	local -r i3_dir="$1"
	local -r bindings="$2"
	local repository
	repository=$(assign_cfg_repo)
	printf "Copying i3 keyboard bindings...\n"
	cp -v "$repository/$bindings" "$i3_dir/$bindings"
	return 0
}

show_bindings() {
	local -r i3_dir="$1"
	local -r bindings="$2"
	[[ -f "$i3_dir/$bindings" ]] || copy_bindings "$i3_dir" "$bindings"
	printf "i3wm keybindings:\n"
	column -t -s "|" -N Binding,Action,Binding,Action "$i3_dir/$bindings"
	return 0
}

main() {
	local -r script="${0##*/}"
	local -r version="1.11.26219"
	local -r i3_dir=~/.config/i3
	local -r i3_bindings=keybindings.conf
	if [[ "$DESKTOP_SESSION" == "i3" ]]; then
		clearscreen
		show_bindings "$i3_dir" "$i3_bindings"
	else
		printf "i3wm is not the current desktop session.\n"
	fi
	over_line "$script $version"
	exit
}

main "$@"
