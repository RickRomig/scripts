# shellcheck source=/home/rick/bin/files/functionlib.bash
source ~/bin/files/functionlib.bash || { printf "\e[91mERROR:\e[0m Unable to source functionlib.bash\n"; exit 1; }

check_dependencies() {
	local -r packages=(fzf git)
	check_packages "${packages[@]}"
	return 0
}

check_repo() {
	local -r git_repo="$1"
	local -r dl_dir=~/Downloads
	if [[ $(find "$dl_dir/$git_repo" -maxdepth 1 -type f 2>/dev/null) ]]; then
		printf "The %s directory is not empty. Updating the cloned repository...\n" "$git_repo"
		pushd "$dl_dir/$git_repo" >/dev/null || return "$E_POPD_PUSHD"
		git checkout .
		git pull
		popd >/dev/null || return "$E_POPD_PUSHD"
	else
		clone_repo "$git_repo" "$dl_dir"
	fi
	return "$?"
}

clone_repo() {
	local -r git_repo="$1"
	local -r dl_dir="$2"
	local url
	case "$git_repo" in
		configs | scripts | i3wm-debian )
			url="$GITHUB_URL" ;;
		* )
			url="$GITEA_URL"
	esac
	git clone "$url/${git_repo}.git" "$dl_dir/$git_repo"
	return "$?"
}

select_repo() {
	local -r fmenu="fzf --header=REPOSITORIES \
		--layout=reverse \
		--exact \
		--border=bold \
		--border=rounded \
		--margin=5% \
		--color=dark \
		--height=95% \
		--info=hidden \
		--header-first \
		--bind change:top \
		--prompt"
	local selected
	local -ra repos=(
		configs
		fnloc
		fnloc-win
		gitea-server
		homepage
		i3wm-debian
		scripts
	)
	selected=$($fmenu "Select repository: " < <(printf "%s\n" "${repos[@]}"))
	printf "%s" "$selected"
}

main() {
	local -r script="${0##*/}"
	local -r version="6.0.26308"
	local -i exit_code=0
	local selected
	check_dependencies
	selected=$(select_repo)
	if [[ -z "$selected" ]]; then
		printf "%s No repository selected.\n" "$RED_WARNING" >&2
		exit_code="$E_MISSING_ARG"
	else
		check_repo "$selected"
		exit_code="$?"
	fi
	over_line "$script $version"
	exit "$exit_code"
}

main "$@"
