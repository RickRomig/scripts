# shellcheck source=/home/rick/bin/functionlib.bash
source ~/bin/functionlib.bash || { printf "\e[91mERROR:\e[0m Unable to source functionlib.bash\n"; exit 1; }

help() {
  local -r script="$1"
  local -r version="$2"
  local -ri errcode="${3:-1}"
  local -r updated="05 May 2026"
  cat << _HELP_
${orange}$script${normal} $version, Updated: $updated
Downloads a web page to the current directory.

${green}Usage:  ${normal} $script [URL | OPTION]
${green}Example:${normal} $script https://example.com/index.html
${orange}Available options:${normal}
  -h | --help  Show this help message and exit.
_HELP_
  exit "$errcode"
}

download_page() {
  local -r url="$1"
  local domain status
  domain=$(sed 's|^[^/]*//||; s|^www\.||; s|/.*$||' <<< "$url")
  printf "Downloading %s to %s\n" "$url" "$PWD"
  wget --quiet --recursive --page-requisites --html-extension --convert-links --restrict-file-names=windows --domains "$domain" --no-parent "$url"
  status="$?"
  print_status "$status"
  return "$status"
}

print_status() {
  local -r status="$1"
  local -ra exit_codes=(
    "No problems occurred"
    "Generic error code"
    "Parse error"
    "File I/O error"
    "Network Failure"
    "SSL verification error"
    "Username/password authentication failure"
    "Protocol errors"
    "Server issued an error response"
  )
  if [[ "$status" -eq 0 ]]; then
    printf "Page succesfully downloaded.\n"
  else
    printf "Download failed with exit code: %s.\n" "$status"
    printf "Error: %s\n" "${exit_codes[status]}"
  fi
  return "$status"
}

check_arguments() {
  local re="^https?:\/\/.*"
  local url
  if [[ "$#" -eq 0 ]]; then
    printf "%s No argument passed.\n" "$RED_ERROR" >&2
    help "$script" "$version" "$E_MISSING_ARG"
  elif [[ "$1" = "--help" || "$1" = "-h" ]]; then
    help "$script" "$version" 0
  elif [[ $1 =~ $re ]]; then
    url="$*"
    download_page "$url"
    return "$?"
  else
    printf "%s Invalid argument - %s\n" "$RED_ERROR" "$1" >&2
    help "$script" "$version" "$E_INVALID_ARG"
  fi
}

main() {
  local -r script="${0##*/}"
  local -r version="2.4.26125"
  local -i exit_code=0
  check_package wget
  check_arguments "$@"
  exit_code="$?"
  over_line "$script $version"
  exit "$exit_code"
}

main "$@"
