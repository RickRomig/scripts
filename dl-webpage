# shellcheck source=/home/rick/bin/files/functionlib.bash
. ~/bin/files/functionlib.bash || { printf "\e[91mERROR:\e[0m Unable to source functionlib.bash\n"; exit 1; }

help() {
  local -r script="$1"
  local -r version="$2"
  local -ri errcode="${3:-1}"
  local -r updated="29 Oct 2026"
  cat <<- _HELP_
	${orange}$script${normal} $version, Updated: $updated
	Downloads a web page to the current directory.

	${green}Usage:  ${normal} $script [URL | OPTION]
	${green}Example:${normal} $script https://example.com/index.html
	${orange}Available options:${normal}
	-h | --help  Show this help message and exit.
	_HELP_
	return "$errcode"
}

print_status() {
	local -ri code="$1"
	local -rA return_code=(
		[0]="No problems occurred. Download successful."
		[1]="Generic error."
		[2]="Parse error (e.g., issues with command-line options)."
		[3]="File I/O error (e.g., problems reading or writing files)."
		[4]="Network failure (e.g., unable to connect to the server)."
		[5]="SSL verification failure (e.g., certificate issues)."
		[6]="Username/password authentication failure."
		[7]="Protocol errors (e.g., issues with the protocol used)."
		[9]="Server issued an error response (e.g., HTTP error)."
	)
	printf "Code: %d - %s\n" "$code" "${return_code[$code]}" >&2
	return 0
}

download_page() {
	local -r url="$1"
	local -i code=0
	local domain
	domain=$(sed 's|^[^/]*//||; s|^www\.||; s|/.*$||' <<< "$url")
	printf "Downloading %s to %s\n" "$url" "$PWD"
	wget --quiet --recursive --page-requisites --html-extension --convert-links --restrict-file-names=windows --domains "$domain" --no-parent "$url"
	code="$?"
	print_status "$code"
	return "$code"
}

check_arguments() {
	local -r re="^https?:\/\/.*"
	local url
	if [[ "$#" -eq 0 ]]; then
		printf "%s No argument passed.\n" "$RED_ERROR" >&2
		help "$script" "$version" "$E_MISSING_ARG"
	elif [[ "$1" = "--help" || "$1" = "-h" ]]; then
		help "$script" "$version" 0
	elif [[ $1 =~ $re ]]; then
		url="$*"
		check_package wget
		download_page "$url"
	else
		printf "%s Invalid argument: %s\n" "$RED_ERROR" "$1" >&2
		help "$script" "$version" "$E_INVALID_ARG"
	fi
	return "$?"
}

main() {
	local -r script="${0##*/}"
	local -r version="3.0.26302"
	local -i exit_code=0
	check_arguments "$@"
	exit_code="$?"
	over_line "$script $version"
	exit "$exit_code"
}

main "$@"
