# shellcheck source=/home/rick/bin/files/functionlib.bash
. ~/bin/files/functionlib.bash || { printf "\e[91mERROR:\e[0m Unable to source functionlib.bash\n"; exit 1; }

help() {
	local -ri errcode="${1:-1}"
	local -r updated="27 Nov 2026"
	cat <<- _HELP_
	${orange}$script${normal} $version ($updated)
	Scans a range of IP addresses to determine if they are online.

	${green}Usage:${normal} $script IP1 IP2
	${orange}Example:${normal} $script 10 20
	Takes 2 integer arguments between 1 and 254 (last octets of address).
	First argument must be less than the second.
	_HELP_
	exit "$errcode"
}

check_arg_values() {
	# returns TRUE only if both octets are positive integers within the range of valid IP addresses.
	local re="^[0-9]+$"
	if ! [[ "$ip1" =~ $re ]] || ! [[ "$ip2" =~ $re ]]; then
		printf "%s Invalid argument\n" "$RED_ERROR" <&2
		return "$FALSE"
	elif (( ip1 > ip2 )); then
		printf "%s Invalid order\n" "$RED_ERROR" <&2
		return "$FALSE"
	elif (( ip1 < 1 )) || (( ip2 > 254 )); then
		printf "%s Invalid range\n" "$RED_ERROR" <&2
		return "$FALSE"
	else
		return "$TRUE"
	fi
}

scan_range() {
	local -i ip
	for (( ip=ip1; ip<=ip2; ip++ )); do
		printf "%s.%d " "$LOCALNET" "$ip"
		grep -E "0 response|0 packets received" < <(arping -c 1 "$LOCALNET.$ip") > /dev/null && printf "no response\n" || printf "responded\n"
	done
	return "$?"
}

main() {
	local -r script="${0##*/}"
	local -r version="5.0.26331"
	exit_code=0
	[[ "$1" == "-h" || "$1" == "--help" ]] && help 0
	if [[ $# -lt 2 ]]; then
		printf "%s Too few arguments\n" "$RED_ERROR" <&2
		help "$E_MISSING_ARG"
	else
		local ip1="$1"
		local ip2="$2"
		check_arg_values || help "$E_INVALID_ARG"
		check_package iputils-arping
		scan_range
		exit_code="$?"
	fi
	over_line "$script $version"
	exit "$exit_code"
}

main "$@"
