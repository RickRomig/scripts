# shellcheck source=/home/rick/bin/files/functionlib.bash
source ~/bin/files/functionlib.bash || {
	printf "\e[91mERROR:\e[0m Unable to source functionlib.bash\n"
	exit 1
}

help() {
	local -ri errcode="${1:-1}"
	local -r updated="20 Nov 2026"
	cat <<- _HELP_
	${orange}$script${normal} $version ($updated)
	Installs, updated, or removes Google Chrome.

	${green}Usage:${normal} $script [-hir]
	${orange}Available options:${normal}
	-h	Show this help message and exit
	-i	Install Google Chrome
	-r	Remove Google Chrome
	_HELP_
	exit "$errcode"
}

chrome_version() {
	google-chrome-stable --version
	return 0
}

set_gpg_key() {
	local -r key_url="https://dl.google.com/linux/linux_signing_key.pub"
	printf "Setting the trusted key...\n"
	gpg --dearmor < <(curl -fSsL "$key_url") | sudo tee "$key_file"
	return "$?"
}

set_sources() {
	local -r sources_uri="https://dl.google.com/linux/chrome-stable/deb/"
	local -r sources_list=/etc/apt/sources.list.d/google-chrome.list
	local -r sources_file=/etc/apt/sources.list.d/google-chrome.sources
	[[ -f "$sources_list" ]] && sudo mv "$sources_list" "$sources_list.bak"
	printf "Creating the source list file...\n"
	sudo tee $sources_file <<< \
"X-Repolib-Name: Google Chrome
Types: deb
URIs: $sources_uri
Suites: stable
Components: main
Architectures: amd64
Signed-By: $key_file"
	return "$?"
}

install_google_chrome() {
	if installed google-chrome-stable; then
		printf "%sis already installed\n" "$(chrome_version)" >&2
		return "$E_FILE_EXISTS"
	fi
	sudo_login 2
	local -r key_file="/usr/share/keyrings/google-chrome.gpg"
	check_package curl
	printf "Updating apt cache and installing Google Chrome...\n"
	set_gpg_key
	set_sources
	sudo apt update -qq
	sudo apt-get install -y google-chrome-stable
	if ! installed google-chrome-stable; then
		printf "%s Google Chrome installation failed.\n" "$RED_ERROR" >&2
		return "$E_INSTALLATION"
	fi
	printf "%ssuccessfully installed.\n" "$(chrome_version)"
	return 0
}

remove_google_chrome() {
	if ! installed google-chrome-stable; then
		printf "Google Chrome is not installed.\n"
		return "$E_NOT_INSTALLED"
	fi
	sudo_login 2
	printf "Removing %s...\n" "$(chrome_version)"
	sudo apt purge google-chrome-stable
	find /etc/apt -maxdepth 2 -type f -iname "google*" -exec sudo rm {} \;
	find /usr/share -maxdepth 3 -type d -iname "google*" -exec sudo rm -rf {} \;
	find ~/ -maxdepth 2 -type d -name google-chrome -exec rm -rf {} \;
	printf "Google Chrome removed from this computer.\n"
	return 0
}

main() {
	local -r script="${0##*/}"
	local -r version="6.5.26324"
	local -i exit_code=0
	local -i noOpt=1
	local -r optstr=":hir"
	local opt OPTARG OPTIND
	while getopts "$optstr" opt; do
		case "$opt" in
			h ) help 0 ;;
			i ) install_google_chrome ;;
			r ) remove_google_chrome ;;
			? ) printf "%s Invalid option -%s\n" "$RED_ERROR" "$OPTARG" >&2
				help "$E_INVALID_ARG"
		esac
		exit_code="$?"
		noOpt=0
	done
	if (( noOpt == 1 )); then
		printf "%s No argument passed\n" "$RED_ERROR" >&2
		help "$E_MISSING_ARG"
	fi
	shift "$(( OPTIND - 1 ))"
	over_line "$script $version"
	exit "$exit_code"
}

main "$@"
