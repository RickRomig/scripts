# shellcheck source=/home/rick/bin/functionlib.bash
source ~/bin/functionlib.bash || { printf "\e[91mERROR:\e[0m Unable to source functionlib.bash\n"; exit 1; }

find_images() {
  local num_images
  num_images=$(wc -l < <(find . -maxdepth 1 -type f -iname "*.jp*g"))
  [[ $num_images -gt 0 ]] && return "$TRUE" || return "$FALSE"
}

resize_pics() {
  local size image
  size="$1"
  [[ -d ./resized ]] || mkdir -p ./resized
  printf "Creating resized images in ./resized...\n"
  for image in *.jpg; do
    convert "$image" -resize "$size"x"$size" resized/"${image%}"
    printf "%s -> resized\n" "$image"
  done
  return 0
}

rename_extensions() {
  # rename *.JPG, *.JPEG, *.jpeg -> *.jpg
  find . -maxdepth 1 -type f -iname "*.jp*g" -exec rename 's/\.JPE?G$/\.jpg/i' {}  \;
  return 0
}

main() {
	local -r script="${0##*/}"
  local -r version="1.7.26215"
	local size="${1:-800}"
  if find_images; then
    check_package imagemagick
    rename_extensions
    resize_pics "$size"
  else
    printf "No JPEG images in current directory to process.\n"
  fi
  over_line "$script $version"
  exit
}

main "$@"
