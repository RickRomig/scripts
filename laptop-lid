# shellcheck source=/home/rick/bin/files/functionlib.bash
. ~/bin/files/functionlib.bash || { printf "\e[91mERROR:\e[0m Unable to source functionlib.bash\n"; exit 1; }

set_logind_conf() {
	local repository=~/Downloads/configs
	[[ -d ~/gitea/configs ]] && repository=~/giteas/configs
	if [[ ! -f "$repository/99-sleep.conf" ]]; then
		printf "%s not found. Cannot continue.\n" "$RED_ERROR" >&2
		return "$E_FILENOTFOUND"
	fi
	sudo_login 2
	[[ -d /etc/systemd/sleep.conf.d ]] || sudo mkdir -p /etc/systemd/sleep.conf.d
	printf "Adding /etc/systemd/sleep.conf.d/99-sleep.conf...\n"
	awk -F"/" '{print "==> " $NF}' < <(sudo cp -v "$repository/99-sleep.conf" /etc/systemd/sleep.conf.d/) | sed "s/'$//"
	return "$?"
}

set_rc_local() {
	local pnp
	sudo_login 2
	printf "Setting /etc/rc.local to diable sleep...\n"
	grep -q 'LID' /proc/acpi/wakeup && pnp=$(awk '{print $NF}' < <(cat /proc/acpi/wakeup) | sed '/^platform://')
	sudo tee -a /sys/bus/acpi/drivers/button/unbind <<< "$pnp"
	sudo tee -a /etc/rc.local <<< "/sys/bus/acpi/drivers/button/unbind"
	return "$?"
}

main() {
	local -r script="${0##*/}"
	local -r version="5.0.26303"
	local -r lhost="${HOSTNAME:=-$(hostname)}"
	local -i exit_code=0
	printf "Allows a laptop's lid to be closed without the system going into suspend mode.\n"
	is_laptop || die "$lhost is not a laptop. Operation canceled." "$E_UNSUPPORTED"
	if is_systemd; then
		set_logind_conf
		exit_code="$?"
	elif is_sysv; then
		set_rc_local
		exit_code="$?"
	else
	printf "%s Init system not supported.\n" "$RED_ERROR" >&2
	exit_code="$E_UNSUPPORTED"
	fi
	over_line "$script $version" "-"
	exit "$exit_code"
}

main "$@"
