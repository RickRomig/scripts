# shellcheck source=/home/rick/bin/files/functionlib.bash
. ~/bin/files/functionlib.bash || {
	printf "\e[91mERROR:\e[0m Unable to source functionlib.bash\n"
	exit 1
}

create_readme() {
	local today script_dir
	today=$(date +"%d %B %Y")
	script_dir=$(dirname "$(readlink -f "${0}")")
	# script_dir=~/bin/
	printf "Creating the README.md for the %s project...\n" "$project"
	sed -e '1d' \
		-e "s/<PROJECT>/$project/" \
		-e "s/<DATE>/$today/" "$script_dir/Templates/readme.txt" > README.md
	edit_view_quit README.md
	return "$?"
}

main() {
	local -r script="${0##*/}"
	local -r version="4.0.26327"
	local project="$1"
	[[ "$#" -eq 0 ]] && read -rp "Enter the project name: " project
	if [[ -f README.md ]]; then
		printf "README.md already exists.\n"
		exit_code="$E_FILE_EXISTS"
	else
		create_readme
		exit_code="$?"
	fi
	over_line "$script $version"
	exit "$exit_code"
}

main "$@"
